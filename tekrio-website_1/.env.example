# Copy to .env (or set in your host's dashboard). Never commit real values.
NODE_ENV=production
PORT=3000

# Required to enable /admin in production (disabled if unset)
TEKRIO_ADMIN_USER=admin
TEKRIO_ADMIN_PASSWORD=

# Folder for leads.json - point at a persistent disk/volume
TEKRIO_DATA_DIR=/data

# "true" only when behind a reverse proxy / platform load balancer
TEKRIO_TRUST_PROXY=true

# Optional: Google Analytics 4 ID and Search Console verification token
TEKRIO_GA_ID=
TEKRIO_GSC_VERIFICATION=

# TEKRIO app backend (device catalog for Sell Your Device)
TEKRIO_BACKEND_API_BASE_URL=https://backend-production-17e07.up.railway.app/api/v1

# Pending: backend endpoint that receives leads / sell requests
TEKRIO_APP_API_WEBHOOK_URL=
TEKRIO_APP_API_KEY=
